{
  "name": "masterdnsvpn-node-workspace",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/router"
  ],
  "scripts": {
    "build:bin": "node build.cjs",
    "build:host": "NATIVE_BUILD_TARGET=host node build.cjs",
    "build:ts": "npm run build:ts --workspaces",
    "build:full": "npm run build:bin && npm run build:ts",
    "router:deps": "node build.cjs --update-router-deps",
    "test": "npm test --workspaces"
  },
  "devDependencies": {
    "@types/node": "^24.0.13",
    "node-api-headers": "^1.5.0",
    "typescript": "^5.8.3"
  }
}
